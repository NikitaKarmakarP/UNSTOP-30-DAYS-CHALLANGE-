#include <iostream>
#include <vector>
#include <string>
using namespace std;

struct Node {
    Node* next[36];
    bool terminal;

    Node() {
        terminal = false;
        for (int i = 0; i < 36; i++) {
            next[i] = NULL;
        }
    }
};

int mapChar(char ch) {
    if (ch >= 'A' && ch <= 'Z')
        return ch - 'A';
    return 26 + (ch - '0');
}

void calculate_novelty_scores(const vector<string>& callSigns,
                              vector<int>& result,
                              int& totalScore) {

    Node* trieRoot = new Node();
    totalScore = 0;

    for (int i = 0; i < callSigns.size(); i++) {

        Node* node = trieRoot;
        int matchedPrefix = 0;
        string current = callSigns[i];

        for (int pos = 0; pos < current.length(); pos++) {
            int id = mapChar(current[pos]);

            if (node->next[id] == NULL) {
                node->next[id] = new Node();
            }

            node = node->next[id];

            if (node->terminal) {
                matchedPrefix = pos + 1;
            }
        }

        if (node->terminal) {
            result[i] = -1;
            continue;
        }

        node->terminal = true;
        result[i] = current.length() - matchedPrefix;
        totalScore += result[i];
    }
}

int main() {
    int n;
    cin >> n;

    vector<string> callSigns(n);
    for (int i = 0; i < n; i++) {
        cin >> callSigns[i];
    }

    vector<int> answer(n);
    int total = 0;

    calculate_novelty_scores(callSigns, answer, total);

    for (int x : answer) {
        cout << x << endl;
    }

    cout << "Total: " << total << endl;

    return 0;
}
