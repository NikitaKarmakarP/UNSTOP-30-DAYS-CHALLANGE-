#include <stdio.h>

void computeHorizon(int height[], int n, int result[]) {
    int stack[n];
    int top = -1;

    // Traverse from right to left
    for (int i = n - 1; i >= 0; i--) {

        // Remove towers that are not strictly taller
        while (top >= 0 && height[stack[top]] <= height[i]) {
            top--;
        }

        // If no taller tower exists
        if (top == -1) {
            result[i] = n - i - 1;
        } else {
            result[i] = stack[top] - i;
        }

        // Push current tower index
        stack[++top] = i;
    }
}

int main() {
    int n;
    scanf("%d", &n);

    int height[n];
    for (int i = 0; i < n; i++) {
        scanf("%d", &height[i]);
    }

    int result[n];
    computeHorizon(height, n, result);

    for (int i = 0; i < n; i++) {
        printf("%d", result[i]);
        if (i != n - 1) printf(" ");
    }
    printf("\n");

    return 0;
}
