#include <iostream>
#include <vector>
#include <queue>
#include <cmath>

using namespace std;

void user_logic(int n, vector<vector<int>>& edges, int q,
                vector<vector<int>>& queries,
                vector<vector<int>>& results) {

    int LOG = 1;
    while ((1 << LOG) <= n) LOG++;

    // adjacency list: {node, weight}
    vector<vector<pair<int, int>>> adj(n + 1);

    for (auto &e : edges) {
        int u = e[0];
        int v = e[1];
        int w = e[2];

        adj[u].push_back({v, w});
        adj[v].push_back({u, w});
    }

    // up[j][v] = 2^j-th ancestor of v
    vector<vector<int>> up(LOG, vector<int>(n + 1, 0));

    vector<int> depth(n + 1, 0);

    // dist[v] = total years from root(1) to v
    vector<long long> dist(n + 1, 0);

    // BFS/DFS to calculate depth, dist and immediate parent
    queue<int> qu;
    qu.push(1);

    vector<bool> visited(n + 1, false);
    visited[1] = true;

    while (!qu.empty()) {
        int u = qu.front();
        qu.pop();

        for (auto [v, w] : adj[u]) {
            if (visited[v]) continue;

            visited[v] = true;

            up[0][v] = u;
            depth[v] = depth[u] + 1;
            dist[v] = dist[u] + w;

            qu.push(v);
        }
    }

    // Binary lifting table
    for (int j = 1; j < LOG; j++) {
        for (int v = 1; v <= n; v++) {
            up[j][v] = up[j - 1][up[j - 1][v]];
        }
    }

    // LCA function
    auto lca = [&](int a, int b) {
        if (depth[a] < depth[b])
            swap(a, b);

        // Bring a to the same depth as b
        int diff = depth[a] - depth[b];

        for (int j = 0; j < LOG; j++) {
            if (diff & (1 << j)) {
                a = up[j][a];
            }
        }

        if (a == b)
            return a;

        // Lift both nodes together
        for (int j = LOG - 1; j >= 0; j--) {
            if (up[j][a] != up[j][b]) {
                a = up[j][a];
                b = up[j][b];
            }
        }

        return up[0][a];
    };

    // Answer queries
    for (int i = 0; i < q; i++) {
        int x = queries[i][0];
        int y = queries[i][1];

        int ancestor = lca(x, y);

        // Total years between x and y
        long long years =
            dist[x] + dist[y] - 2LL * dist[ancestor];

        // Number of rulers on the path, including both endpoints
        int rulers =
            depth[x] + depth[y] - 2 * depth[ancestor] + 1;

        results[i][0] = (int)years;
        results[i][1] = rulers;
    }
}

int main() {
    int n;
    cin >> n;

    vector<vector<int>> edges(n - 1, vector<int>(3));

    for (int i = 0; i < n - 1; i++) {
        cin >> edges[i][0] >> edges[i][1] >> edges[i][2];
    }

    int q;
    cin >> q;

    vector<vector<int>> queries(q, vector<int>(2));

    for (int i = 0; i < q; i++) {
        cin >> queries[i][0] >> queries[i][1];
    }

    vector<vector<int>> results(q, vector<int>(2));

    user_logic(n, edges, q, queries, results);

    for (int i = 0; i < q; i++) {
        cout << results[i][0] << " "
             << results[i][1] << endl;
    }

    return 0;
}
