#include <iostream>
#include <vector>
#include <queue>
#include <tuple>
#include <climits>

using namespace std;

typedef long long ll;

ll minTokenRoute(int n, int m, int k, int src, int dst,
                 const vector<int>& fromArr,
                 const vector<int>& toArr,
                 const vector<ll>& wArr) {

    vector<vector<pair<int, ll>>> graph(n + 1);

    for (int i = 0; i < m; i++) {
        graph[fromArr[i]].push_back({toArr[i], wArr[i]});
    }

    const ll INF = LLONG_MAX;
    vector<vector<ll>> dist(n + 1, vector<ll>(k + 1, INF));

    priority_queue<
        tuple<ll, int, int>,
        vector<tuple<ll, int, int>>,
        greater<tuple<ll, int, int>>
    > pq;

    dist[src][0] = 0;
    pq.push({0, src, 0});

    while (!pq.empty()) {
        auto [cost, u, used] = pq.top();
        pq.pop();

        if (cost > dist[u][used]) continue;

        for (auto [v, w] : graph[u]) {

            // Travel without using token
            if (dist[v][used] > cost + w) {
                dist[v][used] = cost + w;
                pq.push({dist[v][used], v, used});
            }

            // Travel using one token
            if (used < k && dist[v][used + 1] > cost) {
                dist[v][used + 1] = cost;
                pq.push({cost, v, used + 1});
            }
        }
    }

    ll ans = INF;
    for (int i = 0; i <= k; i++) {
        ans = min(ans, dist[dst][i]);
    }

    return (ans == INF ? -1 : ans);
}

int main() {
    int n, m, k, src, dst;
    cin >> n >> m >> k >> src >> dst;

    vector<int> fromArr(m), toArr(m);
    vector<ll> wArr(m);

    for (int i = 0; i < m; i++) {
        cin >> fromArr[i] >> toArr[i] >> wArr[i];
    }

    cout << minTokenRoute(n, m, k, src, dst, fromArr, toArr, wArr) << endl;

    return 0;
}
