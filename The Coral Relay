#include <stdio.h>
#include <stdlib.h>

typedef long long ll;

typedef struct {
    int a, b;
    ll cost;
} Edge;

int *parent, *size;

int findRoot(int x) {
    while (parent[x] != x) {
        parent[x] = parent[parent[x]];
        x = parent[x];
    }
    return x;
}

int unite(int x, int y) {
    int rx = findRoot(x);
    int ry = findRoot(y);

    if (rx == ry)
        return 0;

    if (size[rx] < size[ry]) {
        int temp = rx;
        rx = ry;
        ry = temp;
    }

    parent[ry] = rx;
    size[rx] += size[ry];
    return 1;
}

int compareEdges(const void *p1, const void *p2) {
    Edge *e1 = (Edge *)p1;
    Edge *e2 = (Edge *)p2;

    if (e1->cost < e2->cost) return -1;
    if (e1->cost > e2->cost) return 1;
    return 0;
}

int main() {
    int n, m;
    scanf("%d %d", &n, &m);

    Edge *edges = (Edge *)malloc(m * sizeof(Edge));

    for (int i = 0; i < m; i++) {
        scanf("%d %d %lld", &edges[i].a, &edges[i].b, &edges[i].cost);
    }

    qsort(edges, m, sizeof(Edge), compareEdges);

    parent = (int *)malloc((n + 1) * sizeof(int));
    size = (int *)malloc((n + 1) * sizeof(int));

    for (int i = 1; i <= n; i++) {
        parent[i] = i;
        size[i] = 1;
    }

    ll answer = 0;
    int usedEdges = 0;

    for (int i = 0; i < m; i++) {
        if (unite(edges[i].a, edges[i].b)) {
            answer += edges[i].cost;
            usedEdges++;

            if (usedEdges == n - 1)
                break;
        }
    }

    if (usedEdges == n - 1)
        printf("%lld\n", answer);
    else
        printf("-1\n");

    free(edges);
    free(parent);
    free(size);

    return 0;
}
